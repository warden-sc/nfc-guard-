<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NfcGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nfc_primary</item>
        <item name="colorOnPrimary">@color/nfc_on_primary</item>
        <item name="colorPrimaryContainer">@color/nfc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nfc_on_primary_container</item>
        <item name="colorSecondary">@color/nfc_primary</item>
        <item name="colorOnSecondary">@color/nfc_on_primary</item>
        <item name="android:colorBackground">@color/nfc_background</item>
        <item name="colorSurface">@color/nfc_surface</item>
        <item name="colorOnSurface">@color/nfc_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/nfc_on_surface_variant</item>
        <item name="colorOutline">@color/nfc_outline</item>
        <item name="colorError">@color/nfc_danger</item>
        <item name="android:statusBarColor">@color/nfc_background</item>
        <item name="android:navigationBarColor">@color/nfc_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>

    <style name="Widget.NfcGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/nfc_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">20dp</item>
    </style>

    <style name="TextAppearance.NfcGuard.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/nfc_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.NfcGuard.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/nfc_on_surface_variant</item>
    </style>
</resources>
