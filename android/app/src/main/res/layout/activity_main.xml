<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nfc_background"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- 상단 앱 이름 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/nfc_on_surface"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 보호 상태 카드 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NfcGuard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/statusBadge"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_status_badge">

                        <ImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_launcher_monochrome"
                            app:tint="@color/nfc_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/status_on_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/nfc_on_surface"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/protectionSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/status_switch_cd" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/status_on_desc"
                    android:textAppearance="@style/TextAppearance.NfcGuard.Body" />

                <TextView
                    android:id="@+id/detectionLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/nfc_on_surface"
                    tools:text="@string/level_basic" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 체크리스트 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/checklistCard"
            style="@style/Widget.NfcGuard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/checklist_title"
                    android:textAppearance="@style/TextAppearance.NfcGuard.SectionTitle" />

                <include
                    android:id="@+id/rowNotifications"
                    layout="@layout/item_check_row" />

                <include
                    android:id="@+id/rowNfc"
                    layout="@layout/item_check_row" />

                <include
                    android:id="@+id/rowBattery"
                    layout="@layout/item_check_row" />

                <include
                    android:id="@+id/rowOnboarding"
                    layout="@layout/item_check_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 감지 기록 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NfcGuard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_title"
                    android:textAppearance="@style/TextAppearance.NfcGuard.SectionTitle" />

                <TextView
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="24dp"
                    android:text="@string/history_empty"
                    android:textAppearance="@style/TextAppearance.NfcGuard.Body" />

                <LinearLayout
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_horizontal"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/modelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/nfc_on_surface_variant"
            tools:text="@string/model_inactive" />
    </LinearLayout>
</ScrollView>
